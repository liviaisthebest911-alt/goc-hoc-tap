# Sao chép thành .env.local và điền giá trị. Trên Vercel, khai báo trong Environment Variables.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng phía server, không thêm tiền tố NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Mật khẩu đăng nhập Admin. Nên dài ít nhất 16 ký tự và là chuỗi ngẫu nhiên.
ADMIN_PASSCODE=
# Khóa ký cookie phiên, tối thiểu 32 ký tự. Tạo bằng: openssl rand -base64 32
ADMIN_SESSION_SECRET=
